generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
}